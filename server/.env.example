# Copy to server/.env and fill in locally. Never commit .env or paste keys in chat.
# Names are fixed by docs/api-contracts.md §6. Blank means "not set".

# Port the API listens on. Blank = 3001.
PORT=
# Origin(s) allowed by CORS, comma-separated. Blank = http://localhost:5173 and http://127.0.0.1:5173.
CLIENT_ORIGIN=

# Claude via the Anthropic API (AI module): answers assistant questions when set (contract §8 #6).
# An API key from platform.claude.com (starts with sk-ant-). Optional at startup.
ANTHROPIC_API_KEY=
# Blank = claude-sonnet-5-5.
ANTHROPIC_MODEL=

# PostgreSQL for structured portfolio data (server/db/README.md). Optional at startup: without it
# the server still runs. Must match the root .env used by docker compose, e.g.
# postgres://portfolio:<POSTGRES_PASSWORD>@localhost:5432/portfolio
DATABASE_URL=

# OpenRouter: alternative answer provider, used only when ANTHROPIC_API_KEY is blank. Its key can
# also serve the embeddings below. Without any answer model the dashboard and flags still work.
OPENROUTER_API_KEY=
# Model ID on OpenRouter, e.g. anthropic/claude-sonnet-5.5.
OPENROUTER_MODEL=

# Embedding provider (RAG module). Optional at startup; needed for `npm run ingest` and retrieval.
# Approved: OpenRouter embeddings with openai/text-embedding-3-small (1536 dimensions).
# The OpenRouter key can be reused here. Check with `npm run smoke:embeddings`.
EMBEDDING_API_KEY=
# e.g. https://openrouter.ai/api/v1
EMBEDDING_BASE_URL=
# e.g. openai/text-embedding-3-small
EMBEDDING_MODEL=
