# Copy to server/.env and fill in locally. Never commit .env or paste keys in chat.
# Names are fixed by docs/api-contracts.md §6. Blank means "not set".

# Port the API listens on. Blank = 3001.
PORT=
# Origin allowed by CORS (the Vite dev server). Blank = http://localhost:5173.
CLIENT_ORIGIN=

# OpenRouter (AI module). Optional at startup: without it the dashboard and flags still work
# and /api/health reports openRouterConfigured: false.
OPENROUTER_API_KEY=
# Model ID on OpenRouter. Not decided yet (contract §8 #6).
OPENROUTER_MODEL=

# Embedding provider (RAG module). Optional at startup; needed for `npm run ingest` and retrieval.
# Provider and model not decided yet (contract §8 #5).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
