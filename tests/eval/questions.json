  "fieldGuide": {
    "category": "numerical | narrative | mixed | no_evidence | injection",
    "expectedQuestionType": "questionType the router should return; null = any value accepted",
    "expectedStatus": "allowed validation.status values",
    "expectedInitiatives.rule": "how to derive the expected initiative set from the scorecard; 'ids' is filled in after data lands",
    "expectedFigures": "metric names (InitiativeMetrics / PortfolioSummary fields) that must appear in figures[]",
    "expectedCitationFiles": "charter files that must appear in citations[]; filled in after charters land",
    "requireCitations": "true = citations[] must be non-empty and every [Cn] in answer must match one",
    "mustNotContain": "strings that must not appear in the answer (case-insensitive)"
  },
