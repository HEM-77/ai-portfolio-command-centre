# Docker Compose settings for the local PostgreSQL (docker-compose.yml).
# Copy to .env in the repository root and fill in locally. Never commit .env.
# The server reads its own connection string from server/.env (DATABASE_URL); keep the two in sync.

# Database name and user created on first start. Blank = "portfolio".
POSTGRES_DB=
POSTGRES_USER=
# Required. Choose any local password; compose will not start without it.
POSTGRES_PASSWORD=
# Host port, bound to 127.0.0.1 only. Blank = 5432.
POSTGRES_PORT=
